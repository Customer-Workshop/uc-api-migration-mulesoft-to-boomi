{
  "case": "login-invalid-credentials",
  "description": "POST /auth/login with a wrong password returns the source's 401 invalid_credentials body",
  "request": {
    "method": "POST",
    "path": "/auth/login",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "username": "jdoe",
      "password": "wrong-password",
      "clientId": "sf-int-client"
    }
  },
  "expected": {
    "status": 401,
    "body": {
      "error": "invalid_credentials",
      "error_description": "Invalid username or password"
    }
  }
}
