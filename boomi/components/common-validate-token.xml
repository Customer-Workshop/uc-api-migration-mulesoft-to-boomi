<bns:Component xmlns:bns="http://api.platform.boomi.com/" type="process"
               name="Common - Validate Token">
  <bns:object>
    <process>
      <shapes>
        <shape name="start" shapetype="start" next="check_header"/>
        <shape name="check_header" shapetype="decision" whenTrue="q_token" whenFalse="msg_missing">
          <condition operator="exists">
            <left kind="header" name="authorization" path="bearer"/>
          </condition>
        </shape>
        <shape name="msg_missing" shapetype="message" next="ret_missing">
          <template>{"error": "missing_token", "error_description": "Authorization header is missing or invalid"}</template>
        </shape>
        <shape name="ret_missing" shapetype="returndocuments" status="401" halt="true"/>
        <shape name="q_token" shapetype="connectoraction" connector="database" operation="select" next="token_found">
          <sql>SELECT access_token, expires_at, client_id FROM api_clients WHERE access_token = :token AND expires_at &gt; :currentTime</sql>
          <parameter name="token" kind="header" ref="authorization" path="bearer"/>
          <parameter name="currentTime" kind="function" function="now_iso"/>
        </shape>
        <shape name="token_found" shapetype="decision" whenTrue="ok" whenFalse="msg_invalid">
          <condition operator="notempty">
            <left kind="payload"/>
          </condition>
        </shape>
        <shape name="msg_invalid" shapetype="message" next="ret_invalid">
          <template>{"error": "invalid_token", "error_description": "Invalid or expired access token"}</template>
        </shape>
        <shape name="ret_invalid" shapetype="returndocuments" status="401" halt="true"/>
        <shape name="ok" shapetype="returndocuments" status="200"/>
      </shapes>
    </process>
  </bns:object>
</bns:Component>
