<bns:Component xmlns:bns="http://api.platform.boomi.com/" type="process"
               name="EMP - Health Check">
  <bns:object>
    <process>
      <route method="GET" path="/health"/>
      <shapes>
        <shape name="start" shapetype="start" next="ping"/>
        <shape name="ping" shapetype="connectoraction" connector="database" operation="select" next="set_ts">
          <sql>SELECT 1 as health_check</sql>
        </shape>
        <shape name="set_ts" shapetype="properties" next="ok_msg">
          <property name="ts" kind="function" function="now_iso"/>
        </shape>
        <shape name="ok_msg" shapetype="message" next="done">
          <template>{"status": "healthy", "database": "connected", "timestamp": "{{property:ts}}"}</template>
        </shape>
        <shape name="done" shapetype="returndocuments" status="200"/>
      </shapes>
    </process>
  </bns:object>
</bns:Component>
